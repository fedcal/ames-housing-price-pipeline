# --- Dati grezzi e processati ---
# Il dataset Ames viene scaricato runtime da JSE.
# Non lo committiamo per non duplicare la fonte ufficiale.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# --- Modelli serializzati ---
# I modelli .joblib vengono rigenerati da `ames-train`.
# Pesano ~80 MB (RandomForest) → fuori dal repo.
reports/models/*
!reports/models/.gitkeep

# --- Output di training (riproducibili) ---
reports/cv_summary.csv
reports/holdout_metrics.json

# --- Plots (rigenerati ad ogni run) ---
